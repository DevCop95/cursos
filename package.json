{
  "name": "cursodev101x",
  "version": "1.0.0",
  "description": "Plataforma de Cursos Dev101x - Ciberseguridad & Inteligencia Artificial",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "build:css": "tailwindcss -c tailwind.config.js -i css/tailwind.src.css -o css/tailwind.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.js -i css/tailwind.src.css -o css/tailwind.css --watch",
    "test": "node --test \"tests/*.test.js\"",
    "release": "node scripts/icons.mjs && node scripts/release.mjs",
    "pages": "node scripts/course-pages.mjs",
    "smoke": "npm --prefix e2e run smoke",
    "capturas": "npm --prefix e2e run capturas"
  },
  "keywords": [
    "dev101x",
    "cybersecurity",
    "ai",
    "learning-platform"
  ],
  "author": "Dev101x",
  "license": "MIT",
  "devDependencies": {
    "tailwindcss": "^3.4.19"
  },
  "type": "module"
}
